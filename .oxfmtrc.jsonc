{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"ignorePatterns": [
		".agents/skills/**",
		".claude/skills/**",
		".pi/skills/**",
		".pi/prompts/**",
		"openspec/changes/remove-unsupported-client-features/Cashier-PR26-QA-report.md"
	],
	// Tailwind CSS class sorting (replaces prettier-plugin-tailwindcss)
	"experimentalTailwindcss": {}
}
